# Copy to .env and fill in your own Razorpay dashboard keys
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

PORT=3000

# Restrict API CORS to your production domain (optional; defaults to *)
ALLOWED_ORIGIN=https://indiafattofit.com

# WhatsApp number that receives consultation bookings.
# Digits with country code, no "+" and no spaces.
DOCTOR_WHATSAPP=917801009912

# Where consultation bookings are appended as JSON lines (optional).
# Ephemeral on serverless hosts — use a database in production.
BOOKINGS_FILE=data/bookings.jsonl
